{
  "name": "ALSI BALANCE",
  "short_name": "ALSI",
  "description": "Sistema de tesoreria para Agropesquera La Sinuana S.A.S.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "orientation": "any",
  "background_color": "#0b2545",
  "theme_color": "#0b2545",
  "lang": "es-CO",
  "dir": "ltr",
  "categories": ["finance", "productivity", "business"],
  "iarc_rating_id": "",
  "prefer_related_applications": false,
  "edge_side_panel": { "preferred_width": 480 },
  "launch_handler": {
    "client_mode": "auto"
  },
  "handle_links": "preferred",
  "protocol_handlers": [],
  "screenshots": [],
  "icons": [
    {
      "src": "/static/img/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/img/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/img/favicon.png",
      "sizes": "32x32",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/img/logo.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Movimientos",
      "short_name": "Movimientos",
      "description": "Ver listado de movimientos",
      "url": "/movimientos/",
      "icons": [{ "src": "/static/img/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Dashboard",
      "short_name": "Dashboard",
      "description": "Resumen financiero",
      "url": "/dashboard/",
      "icons": [{ "src": "/static/img/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Reportes",
      "short_name": "Reportes",
      "description": "Reportes financieros",
      "url": "/reportes/",
      "icons": [{ "src": "/static/img/icon-192.png", "sizes": "192x192" }]
    }
  ]
