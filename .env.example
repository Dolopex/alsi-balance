# =========================================================================
# ALSI BALANCE - Variables de entorno (PLANTILLA)
# Copia este archivo como .env y rellena los valores reales.
# NO commitear el .env real a git (esta plantilla SI).
# =========================================================================

# Django
DJANGO_SECRET_KEY=genera-uno-seguro-con-python-c-import-random
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=.up.railway.app,.railway.app,tu-dominio.com

# Base de datos - Railway lo setea automaticamente al agregar Postgres
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Gmail OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# URL de callback - cambiar al dominio real en produccion
GOOGLE_OAUTH_REDIRECT_URI=https://tu-app.up.railway.app/gmail/callback/

# Web Push - VAPID (generar con: python manage.py generar_vapid)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n-----END PRIVATE KEY-----"
VAPID_CLAIMS_SUB=mailto:admin@tu-dominio.com

# Auto-sincronizacion de Gmail (1 = activado)
GMAIL_AUTO_SYNC=1
GMAIL_AUTO_SYNC_INTERVAL=60

# Opcional: Gmail Watch API con Google Cloud Pub/Sub (tiempo real)
# Requiere crear topic en https://console.cloud.google.com/cloudpubsub
# GMAIL_PUBSUB_TOPIC=projects/tu-proyecto/topics/tu-topic
# GMAIL_WATCH_TOKEN=alsi-balance-watch-token