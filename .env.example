# =========================================================================
# ALSI BALANCE - Variables de entorno (PLANTILLA)
# Copia este archivo como .env y rellena los valores reales.
# NO commitear el .env real a git (esta plantilla SI).
# =========================================================================

# Django
DJANGO_SECRET_KEY=genera-uno-seguro-con-python-c-import-random
DJANGO_DEBUG=False
# En Vercel, dejar el default (.vercel.app). Solo cambiar si tenes dominio custom.
DJANGO_ALLOWED_HOSTS=.vercel.app

# Base de datos - Vercel Postgres (recomendado) o Neon externo
# Vercel Postgres: crear en dashboard de Vercel, copy DATABASE_URL
# Neon: https://neon.tech, formato postgresql://user:pass@host/db?sslmode=require
# DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# Gmail OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# URL de callback - debe coincidir EXACTAMENTE con tu dominio de Vercel
GOOGLE_OAUTH_REDIRECT_URI=https://alsi-balance.vercel.app/gmail/callback/

# Web Push - VAPID (generar con: python manage.py generar_vapid)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n-----END PRIVATE KEY-----"
VAPID_CLAIMS_SUB=mailto:admin@tu-dominio.com

# Auto-sincronizacion de Gmail - DESACTIVADO en Vercel (no hay procesos long-running)
# Solo manual via UI. Para activar (solo en deploys long-running como Railway), setear:
# GMAIL_AUTO_SYNC=1
# GMAIL_AUTO_SYNC_INTERVAL=60