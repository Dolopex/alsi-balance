{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "runtime": "python3.11"
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/staticfiles/$1"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "buildCommand": "bash -c 'python manage.py migrate --noinput && python manage.py collectstatic --noinput'",
  "env": {
    "DJANGO_SETTINGS_MODULE": "config.settings",
    "PYTHON_UNBUFFERED": "1",
    "DJANGO_DEBUG": "False"
  }
}